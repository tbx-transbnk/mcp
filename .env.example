# Copy to .env (gitignored) and fill in real values for this deployment.
# Loaded automatically at process startup via python-dotenv - real env vars set
# on the process/container always take priority over anything in .env.
#
# This is open-source code: no deployment's actual API hosts or client secrets
# are baked into the codebase. Everything below is supplied
# per deployment - here locally, or via a secret manager/config map in production
# (to be bifurcated out of this file later).

REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
# Required whenever REDIS_HOST is set - the server refuses to start without it.
REDIS_PASSWORD=
# Only if this Redis is already isolated at the network layer (e.g. a headless Service
# reachable only from this pod's namespace) instead of with AUTH. "1" only - anything
# else is treated as not set.
LMS_MCP_ALLOW_UNAUTHENTICATED_REDIS=

# TransBnk master/LMS API base URLs for this deployment (sandbox/dev/prod/local -
# whichever this .env points at). No default - required.
MASTER_BASE_URL=
LMS_BASE_URL=

# Per-user OAuth (Claude <-> lms-mcp) - required; the server refuses to start without it.
LMS_MCP_OAUTH_BASE_URL=

# OAuth client redirect URIs accepted at dynamic client registration (comma-separated).
# Blank/unset means Claude's own callbacks; http://localhost / 127.0.0.1 are always allowed.
# LMS_MCP_ALLOWED_REDIRECT_URIS=

# TrustHub-OAuth login - active only when all three of these are set.
TRUSTHUB_OAUTH_CLIENT_ID=
TRUSTHUB_OAUTH_CLIENT_SECRET=
TRUSTHUB_LOGIN_URL=
